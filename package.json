{
  "name": "trustbridge-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "trustbridge-dash": "./scripts/cli/index.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && node scripts/next-build.mjs",
    "vercel-build": "npm run db:deploy && npm run build",
    "start": "next start",
    "worker": "node scripts/worker.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "npm run prisma:generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "test:mock": "vitest run tests/integration/horizon-mock.test.ts",
    "test:k6": "BASE_URL=${BASE_URL:-http://localhost:3000} TEST_ADDRESS=${TEST_ADDRESS:-GAS4JQ3KQH84GJ5VJ3M9S6D6A8Y8E5D7Q7XQ5K7ZJ5QZ2NR4Q6X7K4X} VUS=${VUS:-5} DURATION=${DURATION:-30s} k6 run scripts/k6/contributors-check-load.js",
    "test:k6:treasury": "BASE_URL=${BASE_URL:-http://localhost:3000} VUS=${VUS:-5} DURATION=${DURATION:-30s} k6 run scripts/k6/treasury-export-load.js",
    "generate:openapi": "node scripts/generate-openapi-client.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "jiti": "^2.4.2",
    "lucide-react": "^1.17.0",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.422.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "stellar-sdk": "^13.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.45.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^24.1.3",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
